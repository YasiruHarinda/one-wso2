// Template for public/config.js — copy to public/config.js and fill values.
// This file is loaded at runtime by index.html BEFORE the React bundle, so
// every environment can serve the same static bundle with different config.
// Never commit the filled-in config.js (see .gitignore).
window.config = {
  // Asgardeo OAuth
  ONE_WSO2_AUTH_BASE_URL: "https://api.asgardeo.io/t/<your-org>",
  ONE_WSO2_AUTH_CLIENT_ID: "<your-client-id>",
  ONE_WSO2_AUTH_SIGN_IN_REDIRECT_URL: "http://localhost:3000",
  ONE_WSO2_AUTH_SIGN_OUT_REDIRECT_URL: "http://localhost:3000",
  // Optional override — only needed for non-standard Asgardeo deployments.
  // Defaults to the ONE_WSO2_AUTH_BASE_URL with the api. subdomain swapped
  // for myaccount. (Asgardeo Cloud convention).
  // ONE_WSO2_ASGARDEO_MYACCOUNT_URL: "https://myaccount.asgardeo.io/t/<your-org>",

  // UI
  ONE_WSO2_THEME: "wso2",

  // Cafeteria menu backend (daily menu, lunch feedback, dinner orders).
  // Optional — when absent the Menu screen shows a not-connected state and
  // makes no requests. See docs/ported-apps/menu-app.md for the contract.
  // ONE_WSO2_MENU_BACKEND_URL: "https://<gateway>/menu-app/v1",

  // digiops-hr subscription-app backend base URL (PickMe Commute + LaaS
  // opt-in/opt-out). Optional — when absent the People Ops → Subscriptions
  // screens show a not-connected state and make no requests. See
  // docs/ported-apps/subscription-app.md for the contract, including the
  // two Asgardeo admin groups this backend's own /subscriptions/meta-info
  // publishes (there is no separate config key for them).
  // ONE_WSO2_SUBSCRIPTION_BACKEND_URL: "<your-subscription-app-backend-url>",

  // digiops-infra email-group-manager backend base URL. Optional — when
  // absent the Email Groups screen shows a not-connected state and makes no
  // requests. See docs/ported-apps/email-group-manager.md for the contract.
  // ONE_WSO2_EMAIL_GROUPS_BACKEND_URL: "<your-email-group-manager-backend-url>",
  // Sales (auto-recorded meetings) backend — people-ops-suite's meet-app
  // service, reused unchanged. Powers the Sales app's meeting history.
  // Optional, and note what "optional" means here: leaving it unset does NOT hide
  // Sales. The perspective is registered regardless, so the launcher tile and rail
  // stay, and /sales renders its own "not connected" notice — that is how an
  // operator finds out the key is missing, rather than the app looking like the
  // feature was never built. Visibility is controlled by the preview flag below,
  // not by this URL.
  // drive-service base URL is NOT needed here: the streaming URL is minted by
  // meet-app-backend and arrives already pointing at drive-service. Nothing in this app
  // constructs it.
  // ONE_WSO2_REVOPS_BACKEND_URL: "https://apis-stg.wso2.com/<component>/meet-app-backend/v1.0",

  // people-ops-suite people-app backend base URL. Same value as people-app's
  // REACT_APP_BACKEND_BASE_URL — usually a Choreo API gateway URL. Powers
  // the live My profile page (employee + personal info fetch).
  ONE_WSO2_PEOPLE_BACKEND_URL: "<your-people-app-backend-url>",

  // digiops-hr promotion-app backend base URL. Optional — when absent, the
  // Performance & growth card's "Last promoted date" row shows a
  // "not configured" state. Same Choreo API gateway URL pattern as
  // people-app.
  // ONE_WSO2_PROMOTION_BACKEND_URL: "<your-promotion-app-backend-url>",

  // digiops-hr par-app backend base URL. Optional — when absent, the
  // Performance & growth card's active-review row shows a
  // "not configured" state. Same Choreo API gateway URL pattern.
  // ONE_WSO2_PAR_BACKEND_URL: "<your-par-app-backend-url>",

  // digiops-hr banking-app backend base URL. Optional — when absent, the
  // Bank accounts card shows a "not configured" state. Same Choreo API
  // gateway URL pattern; unlike par/promotion apps, this one does NOT
  // require the x-user-timezone-offset header.
  // ONE_WSO2_BANKING_BACKEND_URL: "<your-banking-app-backend-url>",

  // people-ops-suite leave-app backend base URL. Optional — when absent,
  // the People Ops → Leave screens (Apply / Approve / My History /
  // Reports) show a "not configured" state. Same Choreo API gateway URL
  // pattern; leave-app has its own /user-info + privileges.
  // ONE_WSO2_LEAVE_BACKEND_URL: "<your-leave-app-backend-url>",

  // grc-tools grc-platform backend base URL — the Security perspective
  // (Risk Hub, Audit Hub and Admin Console), lifted from grc-tools. Optional —
  // when absent the Security screens cannot load, and the perspective says so
  // rather than calling anything.
  //
  // That backend must list this app's Asgardeo client id in its AUTH_AUDIENCE,
  // or every request from here 401s. Already done for stage. See
  // src/config/apiConfig.ts.
  // ONE_WSO2_GRC_PLATFORM_BACKEND_URL: "<your-grc-platform-backend-url>",

  // digiops-finance backend base URLs — the three apps in the Finance
  // perspective. Each is a separate Ballerina service with its own
  // /user-info + role scheme. Optional — when a URL is absent, that app's
  // screens show a "not connected" state. Same Choreo API gateway URL
  // pattern as the other backends.
  // ONE_WSO2_OPD_BACKEND_URL: "<your-opd-claims-backend-url>",
  // ONE_WSO2_CC_EXPENSES_BACKEND_URL: "<your-cc-expenses-backend-url>",
  // ONE_WSO2_EXPENSE_CLAIMS_BACKEND_URL: "<your-expense-claims-backend-url>",

  // Updates Manager backend base URL. Optional — when absent, UMT shows a
  // not-connected state and makes no requests. The value is the service root;
  // the access check is GET <base-url>/update/user-info.
  // ONE_WSO2_UMT_BACKEND_URL: "<your-updates-manager-backend-url>",

  // leave-app frontend base URL (not its backend) — used to deep-link into
  // flows this webapp doesn't replicate (e.g. sabbatical requests).
  // Optional — when absent, that link is hidden.
  // ONE_WSO2_LEAVE_WEB_APP_URL: "<your-leave-app-frontend-url>",

  // digiops-marketing marketing-ops backend base URL — the Marketing Ops
  // perspective. Unlike every backend above it's Python/FastAPI rather than
  // Ballerina, and its routes live under /api/* (the Choreo proxy preserves
  // that prefix). Same Choreo API gateway URL pattern otherwise. Optional —
  // when absent, the Marketing Ops screens show a "not connected" state.
  // ONE_WSO2_MARKETINGOPS_BACKEND_URL: "<your-marketing-ops-backend-url>",

  // digiops-finance due_diligence backend base URL — the Due Diligence app,
  // surfaced under both the Finance and Legal perspectives. Same Choreo API
  // gateway URL pattern as the other digiops-finance backends above. Optional
  // — when absent, the Due Diligence screens show a "not connected" state.
  // ONE_WSO2_DUE_DILIGENCE_BACKEND_URL: "<your-due-diligence-backend-url>",

  // ISAC base URL — a separate marketing application, linked to from the top of
  // the Marketing Ops rail and opened in a new tab. Nothing here calls it as an
  // API. Optional — when absent, the rail item is omitted entirely rather than
  // rendered as a link that goes nowhere.
  // ONE_WSO2_MARKETINGOPS_ISAC_URL: "<your-isac-url>",

  // CSM base URL — a separate application, reached from its launcher tile and
  // opened in a new tab. Nothing here calls it as an API, and there is no route
  // for it, so it is never a landing choice or a favourite. Optional — when
  // absent, the tile stays in its unbuilt state rather than becoming a link
  // that goes nowhere.
  // ONE_WSO2_CSM_URL: "<your-csm-url>",

  // infra-portal backend — the Infra Portal perspective. Optional — when
  // absent, Infra Portal shows a "not connected" state. Privileges come from
  // this service's own /user-info (987 employee / 762 approver / 123 admin),
  // not from people-app.
  // ONE_WSO2_INFRA_BACKEND_URL: "<your-infra-portal-backend-url>",

  // Pardot UI base URL — for deep-linking to an email template after Email
  // Workbench pushes it. A link target, not an API. Optional; defaults to
  // https://pi.pardot.com, which is correct for every WSO2 environment today.
  // ONE_WSO2_PARDOT_BASE_URL: "https://pi.pardot.com",

  // Salesforce Lightning base URL — for deep-linking to the record an incoming
  // one collided with, from CRM Upload's review queue. A link target, not an
  // API. Optional; defaults to https://wso2.lightning.force.com. Set it only
  // for a sandbox org.
  // ONE_WSO2_SALESFORCE_BASE_URL: "https://wso2.lightning.force.com",

  // Idle handling. Optional — defaults to false. The "Are you still there?"
  // dialog appears after 25 minutes of inactivity either way; this decides only
  // what happens if it is ignored. False leaves it waiting and the session
  // alive; true signs out at 30 minutes, which is what the security checklist
  // (ONEWSO2-R1) asks for.
  // ONE_WSO2_IDLE_AUTO_SIGN_OUT: false,

  // Features that are built and merged but not released yet. Absent or false
  // hides the feature — a deployment that says nothing shows nothing, so
  // production is safe without anyone remembering to add an entry.
  //
  // NOT the same as an empty backend URL above. That means "not wired up";
  // this means "wired up, but not for you yet".
  //
  // Each entry is deleted when its feature ships — a list that only grows
  // stops describing anything.
  //
  // ONE_WSO2_PREVIEW_FEATURES: { umt: false, infra: false },
};
